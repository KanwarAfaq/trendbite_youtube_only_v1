# YouTube: either use one pipe-separated secret or the individual names below.
# Recommended for GitHub: store YOUTUBE_API_KEYS as one repository secret.
YOUTUBE_API_KEYS=key1|key2|key3
# YOUTUBE_API_KEY=
# YOUTUBE_API_KEY_1=
# YOUTUBE_API_KEY_2=
# YOUTUBE_API_KEY_3=
YOUTUBE_API_ENABLED=true

# Live discovery. No DISCOVERY_QUERIES is needed.
DISCOVERY_THEMES=animal|cat|dog|baby|monkey|little boss
DISCOVERY_QUERIES_PER_ATTEMPT=6
DISCOVERY_RESULTS_PER_QUERY=25
DISCOVERY_MAX_CANDIDATES=120
DISCOVERY_FRESH_DAYS=7|30|90|365|1825
DISCOVERY_SLOT_HOURS=12
YOUTUBE_SEARCH_ORDER=date
YOUTUBE_RELEVANCE_LANGUAGE=en
YOUTUBE_SAFE_SEARCH=none
YOUTUBE_VIDEO_LICENSE=creativeCommon
YOUTUBE_REQUIRE_REUSABLE_LICENSE=true

# Set a duration cap if you only want short/reel-friendly clips, e.g. 180.
DISCOVERY_MIN_DURATION=0
DISCOVERY_MAX_DURATION=0

VIDEO_POST_COUNT=10
VIDEO_POST_DELAY_SECONDS=60
VIDEO_MAX_ATTEMPTS=5
DOWNLOAD_DIR=videos
DELETE_LOCAL_AFTER_POST=true

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
FACEBOOK_GRAPH_VERSION=v26.0
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PUBLISH_MODE=reel
